# ---------------------------------------------------------------------------
# Only the values in this file MUST live here. Everything else an admin might
# want to change - app name, SMTP mailbox, weekly digest schedule, AI model and
# key, upload limits, session length, lockout rules, password-reset validity,
# app URL for e-mail links - is edited in the running app under Admin > Settings
# and stored in the database.
#
# The SMTP / AI / digest values below are still read, but only as the INITIAL
# default before anything is saved in Settings. Once saved there, Settings wins.
# ---------------------------------------------------------------------------

# Database - point this at your Postgres. Encode "@" in the password as %40.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/aikyam_ai_tracker

# Signing key for login tokens: a random string of at least 32 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with a weak/placeholder value (unless APP_ENV=development).
# Changing it later signs everyone out, nothing else.
JWT_SECRET=

# production (default) | development
APP_ENV=production

# Where uploaded BRDs are written on disk (bootstrap path, not a UI setting)
UPLOAD_DIR=./uploads

# Where the frontend runs - must match exactly (protocol + host + port).
# Default matches frontend/vite.config.ts's port 5180. In production, when the
# backend serves the built frontend itself, set this to the public URL.
FRONTEND_ORIGIN=http://localhost:5180

# --- Production plumbing (optional) ----------------------------------------
# Built frontend to serve from this process (run `npm run build` in frontend/).
STATIC_DIR=../frontend/dist
# json (one object per line, for log shippers) | text (for a terminal)
LOG_FORMAT=json
LOG_LEVEL=INFO
# Only ever run ONE process with the scheduler on, or digests go out twice.
RUN_SCHEDULER=1
# Set to 1 when behind Caddy/nginx so X-Forwarded-For is used for client IPs.
TRUST_PROXY_HEADERS=0

# --- Initial defaults only; change these later in Admin > Settings ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ANTHROPIC_API_KEY=
DIGEST_CRON_DAY_OF_WEEK=mon
DIGEST_CRON_HOUR=9
DIGEST_CRON_MINUTE=0
DIGEST_TIMEZONE=Asia/Kolkata
JWT_EXPIRE_MINUTES=480
